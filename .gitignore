# Godot 4
.godot/
*.translation

# Exportación Android: nunca subir claves ni binarios.
# export_presets.cfg SÍ se versiona: la compilación en la nube lo necesita
# y no contiene secretos (ver docs/decisiones.md, D-008).
/build/
*.apk
*.aab
*.keystore
*.jks

# Sistema
.DS_Store
Thumbs.db

# Identificadores que Godot genera junto a cada script; el proyecto carga por ruta y se
# regeneran solos, así que no se versionan.
*.uid
__pycache__/
